{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/main.tsx",
    "src/app/App.tsx",
    "src/app/components/HomePage.tsx",
    "src/app/components/IntroLoader.tsx",
    "src/app/components/SEOHead.tsx",
    "src/app/components/premium",
    "vite.config.ts"
  ]
}
